# Main Turso database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth Turso database (users and sessions)
AUTH_DB_URL=libsql://your-auth-database.turso.io
AUTH_DB_TOKEN=your-auth-db-token

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# JWT signing secret (32-byte base64 random string)
JWT_SECRET=your-jwt-secret

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# User ID for local stdio mode (used when running server directly, not via Vercel)
STDIO_USER_ID=local
